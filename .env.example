# Copy to .env and adjust for local or VM deployment.

POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
POSTGRES_DB=lms

# Used by API containers (SQLAlchemy / Alembic)
DATABASE_URL=postgresql+psycopg://lms:lms@postgres:5432/lms

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Shared volume path for submission file attachments (api-1, api-2, worker)
SUBMISSION_STORAGE_PATH=/data/submissions

# Snowflake-style IDs: MUST be unique 0..1023 per API replica (api-1=1, api-2=2 in compose).
WORKER_ID=1

# JWT (change in production)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=24
# Traefik routing (comma-separated hosts). Must match how users reach the gateway.
TRAEFIK_PUBLIC_HOSTS=localhost,127.0.0.1

# --- R12 observability (optional; use profile: docker compose --profile observability up -d) ---
# Grafana is NOT started unless you use the profile above (or set COMPOSE_PROFILES below).
# OTEL gRPC endpoint (no http:// prefix): OpenTelemetry Collector in compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
# OTEL_SERVICE_NAME=lms-api
# If you always want Grafana/Prometheus/Loki/Tempo when you run `docker compose up -d`, uncomment:
# COMPOSE_PROFILES=observability
# Grafana first login (observability profile)
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
